<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="library_preferences"
        android:title="@string/game_list_title">
        <SwitchPreferenceCompat
            android:key="gamespace_auto_game_detect"
            android:title="@string/auto_game_detect_title"
            android:summary="@string/auto_game_detect_summary"
            android:defaultValue="true"
            android:persistent="false" />
        <Preference
            android:key="library_open"
            android:title="@string/library_open"
            android:persistent="false"
            app:isPreferenceVisible="false" />

        <io.github.miner7222.gamespace.library.HideGamesPreference
            android:key="gamespace_hide_games"
            android:title="@string/library_hide_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="game_optimization"
        android:title="@string/game_optimization_title">

        <ListPreference
            android:key="gamespace_default_game_mode"
            android:title="@string/library_default_mode"
            android:summary="%s"
            android:entries="@array/per_app_preferred_mode_entries"
            android:entryValues="@array/per_app_preferred_mode_values"
            android:defaultValue="1"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="game_memory_management"
            android:title="@string/game_memory_management_title"
            android:summary="@string/game_memory_management_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="gamespace_wifi_low_latency"
            android:title="@string/wifi_low_latency_title"
            android:summary="@string/wifi_low_latency_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <Preference
        android:key="global_in_game_options"
        android:title="@string/global_in_game_options_title"
        android:persistent="false" />

    <PreferenceCategory
        android:key="global_preferences"
        android:title="@string/options_other">

        <com.crdroid.settings.preferences.CustomSeekBarPreference
            android:key="gamespace_menu_opacity"
            android:title="@string/icon_idle_opacity_title"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:units="%" />

        <io.chaldeaprjkt.gamespace.preferences.QuickStartAppPreference
            android:key="quick_start_apps"
            android:title="@string/quick_start_apps_title" />

    </PreferenceCategory>

</PreferenceScreen>
